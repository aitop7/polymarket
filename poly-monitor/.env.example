# Local mirror of VPS fetch_live markets (YYYY-MM-DD/{market_id}/)
FETCH_LIVE_DATA_DIR=E:\DataSets\poly\live

# VPS fetch_live serve API (leave empty to disable sync)
# host:port is fine — http:// is added if missing
VPS_SYNC_URL=http://YOUR_VPS_HOST:8787
VPS_SYNC_TOKEN=change-me

# Optional
# FETCH_REAL_ROOT=E:\DataSets\poly\fetch_real
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
